# Dedicated local semantic metadata store. Do not use the operational graph.
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-password
NEO4J_DATABASE=neo4j

# Set true only when NEO4J_URI is a dedicated remote semantic metadata store.
# Never enable this for the operational Finance Genie graph.
NEOCARTA_ALLOW_REMOTE_STORE=false

# Managed Databricks source. DATABRICKS_SERVER_HOSTNAME and
# DATABRICKS_HTTP_PATH can be supplied directly or derived from
# DATABRICKS_HOST and DATABRICKS_WAREHOUSE_ID.
DATABRICKS_HOST=https://dbc-example.cloud.databricks.com
DATABRICKS_PROFILE=your-profile
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
DATABRICKS_CATALOG=graph-on-databricks
DATABRICKS_SCHEMA=graph-enriched-schema

# Set true only when the source uses Unity Catalog governed tags and the
# configured identity can list tag policies. Tag assignments remain upstream
# NeoCarta work; this demo currently ingests definitions only.
DATABRICKS_INGEST_GOVERNED_TAGS=false

# Optional direct SQL connector values. Leave these unset when deriving them
# from DATABRICKS_HOST and DATABRICKS_WAREHOUSE_ID.
# DATABRICKS_SERVER_HOSTNAME=dbc-example.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Optional PAT fallback. Prefer the configured Databricks profile for local use.
# DATABRICKS_TOKEN=dapi-replace-me

# Databricks-hosted semantic retrieval. Ingest stores table and column vectors
# built from names, types, and descriptions. The MCP server uses the same model
# for query embeddings. LiteLLM uses the configured Databricks profile.
EMBEDDING_MODEL=databricks/databricks-gte-large-en

# Foundation Model serving endpoint used by the Ask page to generate SQL/Cypher.
LLM_ENDPOINT_NAME=databricks-claude-sonnet-4-6
