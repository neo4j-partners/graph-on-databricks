# Local development only. cp .env.example .env
# Deployed apps get their configuration from agent.toml and app.yaml.

# Databricks auth profile from ~/.databrickscfg (see `databricks auth profiles`)
DATABRICKS_CONFIG_PROFILE=

# Neo4j Agent Memory Service (NAMS) key from https://memory.neo4jlabs.com/. Leave empty to run
# without memory. Deployed apps read it from the `nams-api-key` app secret resource.
MEMORY_API_KEY=

# Optional: override the model (a Unity Catalog AI Gateway model, system.ai.*)
# LLM_MODEL=system.ai.claude-sonnet-5-5
